{
  "manifest_version": 3,
  "name": "LeetCode CMDK",
  "version": "1.3",
  "description": "Press Cmd/Ctrl + K to search and insert Java & C++ syntax snippets directly into the editor.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "snippets.js",
        "src/storage.js",
        "src/ui.js",
        "src/main.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-world.js"
      ],
      "matches": [
        "*://leetcode.com/*"
      ]
    }
  ]
}
